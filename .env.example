# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env

# Токен бота, полученный от @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID чата, куда будут приходить уведомления о новых заказах.
# Это может быть ваш личный чат с ботом, или отдельная группа/канал.
# Как узнать ID группы: добавьте бота @userinfobot в группу — он покажет её ID.
ADMIN_CHAT_ID=123456789

# ID Google Таблицы (из её ссылки):
# https://docs.google.com/spreadsheets/d/ЭТОТ_ID_ЗДЕСЬ/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Путь к JSON-файлу сервисного аккаунта Google (см. README.md, раздел "Настройка Google Sheets")
GOOGLE_CREDENTIALS_FILE=credentials.json

# Название листа с товарами в таблице
PRODUCTS_SHEET_NAME=Товары

# Как часто (в секундах) бот обновляет каталог из таблицы
CACHE_TTL_SECONDS=180

# Валюта, отображаемая рядом с ценой
CURRENCY_LABEL=сум
